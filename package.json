{
  "name": "grapesjs-ruler",
  "version": "0.3.1",
  "description": "GrapesJS plugin: Photoshop-like rulers around the canvas, a crosshair that follows the cursor (also over the empty area around tablet/mobile frames) and draggable guides.",
  "type": "module",
  "main": "./dist/grapesjs-ruler.umd.cjs",
  "module": "./dist/grapesjs-ruler.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/grapesjs-ruler.umd.js",
  "jsdelivr": "./dist/grapesjs-ruler.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/grapesjs-ruler.js",
      "require": "./dist/grapesjs-ruler.umd.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && node -e \"require('fs').copyFileSync('dist/grapesjs-ruler.umd.cjs','dist/grapesjs-ruler.umd.js')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check:package && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "grapesjs": ">=0.21.0 <1.0.0"
  },
  "devDependencies": {
    "grapesjs": "0.21.13",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.9"
  },
  "keywords": ["grapesjs", "grapesjs-plugin", "ruler", "rulers", "guides", "crosshair", "canvas"],
  "author": "Alexander Shibisty",
  "license": "MIT"
}
